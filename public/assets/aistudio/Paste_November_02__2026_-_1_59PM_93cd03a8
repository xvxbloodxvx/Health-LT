              <div className="h-1 bg-zinc-800 rounded-full mt-1.5 overflow-hidden">
                <div className="h-full bg-indigo-400" style={{ width: `${Math.min(100, ((currentDay.sodium || 0) / 2500) * 100)}%` }}></div>
              </div>
            </div>

