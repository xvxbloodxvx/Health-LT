                <p className="text-xs text-zinc-500">Official source of truth for deterministic nutrition calculation.</p>
              </div>
              <label className="flex items-center space-x-1.5 px-3 py-1.5 bg-zinc-100 hover:bg-white text-zinc-950 text-xs font-mono font-bold rounded-lg cursor-pointer">
                <Camera size={14} />
                <span>Scan Label</span>
                <input type="file" accept="image/*" capture="environment" onChange={handlePhotoUpload} className="hidden" />
              </label>
            </div>

            {pantry.length === 0 ? (
              <div className="bg-zinc-900/40 rounded-2xl border border-dashed border-zinc-800 p-8 text-center space-y-3">
                <Database size={28} className="mx-auto text-zinc-600" />
                <p className="text-xs font-mono text-zinc-400">Your pantry is clean. Snap a photo of any back-of-pack nutrition panel to verify and save it.</p>
              </div>
            ) : (
              <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                {pantry.map((item) => (
                  <div key={item.id} className="bg-zinc-900/40 p-3.5 rounded-xl border border-zinc-800 space-y-2">
                    <div className="flex justify-between items-start">
                      <span className="font-semibold text-xs text-zinc-100">{item.name}</span>
                      <button
                        onClick={() => setPantry(pantry.filter(x => x.id !== item.id))}
                        className="text-zinc-600 hover:text-rose-400"
                      >
                        <Trash2 size={14} />
                      </button>
                    </div>
                    <div className="text-[11px] font-mono text-zinc-400 grid grid-cols-3 gap-1">
                      <div>{item.calories} kcal</div>
                      <div>{item.protein}g Protein</div>
                      <div>{item.net_carbs}g NetCarb</div>
                      <div>{item.sodium}mg Na</div>
                      <div>{item.potassium}mg K</div>
                      <div>{item.magnesium}mg Mg</div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {/* ----------------- TAB: REACTIVE AI ADVISOR ----------------- */}
        {activeTab === 'advisor' && (
          <div className="bg-zinc-900/40 rounded-2xl border border-zinc-800 p-4 space-y-4 font-mono">
            <div className="flex items-center space-x-2 border-b border-zinc-800 pb-3">
              <Bot size={20} className="text-zinc-300" />
              <div>
                <h3 className="text-sm font-bold text-zinc-100">Reactive Keto & Shift Advisor</h3>
                <p className="text-[10px] text-zinc-500">Grounded in your 14-day history, shift patterns, and electrolyte levels.</p>
              </div>
            </div>

            <div className="text-xs text-zinc-400 bg-zinc-950 p-3 rounded-xl border border-zinc-800/80 leading-relaxed">
              "You are on a <span className="text-zinc-200 font-bold">{currentDay.shift}</span> schedule. Your 7-day average net carbs are <span className="text-zinc-200 font-bold">34.2g</span> and potassium is averaging <span className="text-zinc-200 font-bold">3,180mg</span>. Tap a query below or type a question."
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
              {[
                "Why is my weight plateaued this week despite caloric deficit?",
                "How should I split my electrolyte intake for my upcoming PM shift?",
                "Adjust my Day 1 circuit if my pull-up reps drop to 2.",
                "Review my magnesium balance against sleep quality."
              ].map((q, idx) => (
                <button
                  key={idx}
                  onClick={() => alert(`Prompt context attached with your latest logs:\n"${q}"`)}
                  className="p-2.5 bg-zinc-950 hover:bg-zinc-900 border border-zinc-800 text-left rounded-xl text-zinc-300 transition-colors flex justify-between items-center"
                >
                  <span>{q}</span>
                  <ArrowUpRight size={14} className="text-zinc-500 shrink-0 ml-2" />
                </button>
              ))}
            </div>
          </div>
        )}

        {/* ----------------- TAB: SETTINGS & API KEY ----------------- */}
        {activeTab === 'settings' && (
          <div className="bg-zinc-900/40 rounded-2xl border border-zinc-800 p-4 space-y-5 font-mono text-xs">
            <h3 className="text-sm font-bold text-zinc-100 border-b border-zinc-800 pb-2">App Credentials & Free Tier Settings</h3>
            
            <div className="space-y-1.5">
              <label className="text-zinc-400 block font-semibold">Gemini Flash API Key (Free Tier)</label>
              <input
                type="password"
                value={apiKey}
                onChange={(e) => setApiKey(e.target.value)}
                placeholder="AIzaSy..."
                className="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-zinc-100 outline-none focus:border-zinc-500"
              />
              <p className="text-[10px] text-zinc-500">Stored strictly on your device localStorage. 100% free under Google AI Studio limits.</p>
            </div>

            <div className="space-y-1.5 border-t border-zinc-800 pt-3">
              <label className="text-zinc-400 block font-semibold">Blueprint Nutritional Targets</label>
              <div className="grid grid-cols-2 gap-2">
                <div>Net Carb Soft Ceiling: <span className="text-zinc-200 font-bold">30g</span></div>
                <div>Net Carb Hard Ceiling: <span className="text-zinc-200 font-bold">50g</span></div>
                <div>Fiber Daily Floor: <span className="text-zinc-200 font-bold">38g</span></div>
                <div>Protein Target Floor: <span className="text-zinc-200 font-bold">110g</span></div>
              </div>
            </div>
          </div>
        )}

      </main>

      {/* =========================================================================
          NUTRITION LABEL SCANNER OCR MODAL
      ========================================================================= */}
      {ocrModal.open && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-zinc-950 border border-zinc-800 rounded-2xl max-w-md w-full p-5 space-y-4 font-mono text-xs">
            <h3 className="text-sm font-bold text-zinc-100 flex items-center space-x-2">
              <Camera size={16} />
              <span>Nutrition Label OCR Verification</span>
            </h3>

            {ocrModal.isProcessing ? (
              <div className="py-8 text-center space-y-2">
                <RefreshCw className="animate-spin mx-auto text-zinc-400" size={24} />
                <p className="text-zinc-500">Extracting official packaging values...</p>
              </div>
            ) : ocrModal.item ? (
              <div className="space-y-3">
                <div>
                  <label className="text-[10px] text-zinc-500 uppercase">Item Name</label>
                  <input
                    type="text"
                    defaultValue={ocrModal.item.name}
                    id="ocr_name"
                    className="w-full bg-zinc-900 border border-zinc-800 rounded-lg px-2.5 py-1.5 text-zinc-100 font-bold mt-0.5"
                  />
                </div>

                <div className="grid grid-cols-3 gap-2">
                  <div>
                    <label className="text-[10px] text-zinc-500 uppercase">Calories</label>
                    <input type="number" defaultValue={ocrModal.item.calories} id="ocr_cal" className="w-full bg-zinc-900 border border-zinc-800 rounded px-2 py-1 mt-0.5" />
                  </div>
                  <div>
                    <label className="text-[10px] text-zinc-500 uppercase">Protein (g)</label>
                    <input type="number" defaultValue={ocrModal.item.protein} id="ocr_p" className="w-full bg-zinc-900 border border-zinc-800 rounded px-2 py-1 mt-0.5" />
                  </div>
                  <div>
                    <label className="text-[10px] text-zinc-500 uppercase">Net Carbs (g)</label>
                    <input type="number" defaultValue={ocrModal.item.net_carbs} id="ocr_nc" className="w-full bg-zinc-900 border border-zinc-800 rounded px-2 py-1 mt-0.5" />
                  </div>
                  <div>
                    <label className="text-[10px] text-zinc-500 uppercase">Sodium (mg)</label>
                    <input type="number" defaultValue={ocrModal.item.sodium} id="ocr_na" className="w-full bg-zinc-900 border border-zinc-800 rounded px-2 py-1 mt-0.5" />
                  </div>
                  <div>
                    <label className="text-[10px] text-zinc-500 uppercase">Potassium (mg)</label>
                    <input type="number" defaultValue={ocrModal.item.potassium} id="ocr_k" className="w-full bg-zinc-900 border border-zinc-800 rounded px-2 py-1 mt-0.5" />
                  </div>
                  <div>
                    <label className="text-[10px] text-zinc-500 uppercase">Magnesium (mg)</label>
                    <input type="number" defaultValue={ocrModal.item.magnesium} id="ocr_mg" className="w-full bg-zinc-900 border border-zinc-800 rounded px-2 py-1 mt-0.5" />
                  </div>
                </div>

                <div className="flex space-x-2 pt-2">
                  <button
                    onClick={() => {
                      const verified = {
                        id: Date.now().toString(),
                        name: document.getElementById('ocr_name').value,
                        base_grams: 100,
                        calories: parseFloat(document.getElementById('ocr_cal').value) || 0,
                        protein: parseFloat(document.getElementById('ocr_p').value) || 0,
                        net_carbs: parseFloat(document.getElementById('ocr_nc').value) || 0,
                        sodium: parseFloat(document.getElementById('ocr_na').value) || 0,
                        potassium: parseFloat(document.getElementById('ocr_k').value) || 0,
                        magnesium: parseFloat(document.getElementById('ocr_mg').value) || 0,
                      };
                      setPantry(prev => [...prev, verified]);
                      setOcrModal({ open: false, item: null, isProcessing: false });
                    }}
                    className="flex-1 py-2 bg-zinc-100 hover:bg-white text-zinc-950 font-bold rounded-xl"
                  >
                    Commit to Verified Pantry
                  </button>
                  <button
                    onClick={() => setOcrModal({ open: false, item: null, isProcessing: false })}
                    className="px-4 py-2 bg-zinc-900 hover:bg-zinc-800 text-zinc-400 rounded-xl"
                  >
                    Cancel
                  </button>
                </div>
              </div>
            ) : null}
          </div>
        </div>
      )}

      {/* =========================================================================
          BOTTOM TAB NAVIGATION (iOS Safe Area Ergonomics)
      ========================================================================= */}
      <nav className="fixed bottom-0 left-0 right-0 z-40 bg-[#09090b]/95 backdrop-blur-lg border-t border-zinc-800 px-4 py-2 pb-safe">
        <div className="max-w-md mx-auto flex justify-between items-center text-[10px] font-mono">
          {[
            { id: 'dashboard', label: 'Dashboard', icon: Activity },
            { id: 'log', label: 'Log Food', icon: Utensils },
            { id: 'workout', label: 'Workout', icon: Dumbbell },
            { id: 'pantry', label: 'Pantry', icon: Database },
            { id: 'advisor', label: 'Advisor', icon: Bot },
            { id: 'settings', label: 'Settings', icon: Settings },
          ].map((tab) => {
            const Icon = tab.icon;
            const isSelected = activeTab === tab.id;
            return (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`flex flex-col items-center py-1 px-2 rounded-xl transition-all ${
                  isSelected ? "text-zinc-100 font-bold" : "text-zinc-500 hover:text-zinc-300"
                }`}
              >
                <Icon size={18} strokeWidth={isSelected ? 2.5 : 1.8} />
                <span className="mt-1">{tab.label}</span>
              </button>
            );
          })}
        </div>
      </nav>

    </div>
  );
}