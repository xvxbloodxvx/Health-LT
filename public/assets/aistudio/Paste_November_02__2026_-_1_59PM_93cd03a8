                    <div
                      key={item.id}
                      onClick={() => addPantryItemToMeal(item, 100)}
                      className="px-3 py-2 hover:bg-zinc-900 rounded-lg cursor-pointer flex justify-between items-center text-xs font-mono"
                    >
                      <span className="font-medium text-zinc-200">{item.name}</span>
                      <span className="text-zinc-500">{item.calories} kcal | {item.protein}g P | {item.net_carbs}g NC</span>
                    </div>
                  ))}
                </div>
              )}
            </div>

            {/* Hierarchical Meal Lists */}
            {['meal_1', 'meal_2', 'meal_3'].map((mealKey) => {
              const items = currentDay.meals?.[mealKey] || [];
              const subtotalP = items.reduce((acc, i) => acc + (i.protein || 0), 0);
              const subtotalNC = items.reduce((acc, i) => acc + (i.net_carbs || 0), 0);
              const subtotalCal = items.reduce((acc, i) => acc + (i.calories || 0), 0);

              return (
                <div key={mealKey} className="bg-zinc-900/40 rounded-2xl border border-zinc-800 p-4 space-y-3">
                  <div className="flex justify-between items-center">
                    <span className="text-xs font-mono uppercase tracking-widest text-zinc-400 font-bold">
                      {mealKey.replace('_', ' ').toUpperCase()}
                    </span>
                    <span className="text-xs font-mono text-zinc-500">
                      {subtotalCal} kcal | <span className="text-cyan-400">{subtotalP.toFixed(1)}g P</span> | <span className="text-amber-400">{subtotalNC.toFixed(1)}g NC</span>
                    </span>
                  </div>

                  {items.length === 0 ? (
                    <div className="text-xs text-zinc-600 font-mono py-2">No entries logged yet.</div>
