                </div>
                <div>
                  <div className="text-xs text-zinc-500 uppercase font-mono">Morning Weight</div>
                  <div className="flex items-baseline space-x-1">
                    <input
                      type="number"
                      step="0.05"
                      value={currentDay.weight_kg || ''}
                      placeholder="00.0"
