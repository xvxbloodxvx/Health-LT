            </div>

            {/* Sodium */}
            <div className="bg-zinc-900/60 p-2.5 rounded-xl border border-zinc-800">
              <div className="text-[10px] text-zinc-500 uppercase font-mono tracking-wider">Sodium (Na)</div>
