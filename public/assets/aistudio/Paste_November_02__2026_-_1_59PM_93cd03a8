                  <div className="flex items-center space-x-1 mt-1">
                    {[0, 1, 2].map((num) => (
                      <button
                        key={num}
                        onClick={() => updateCurrentDay("bm_count", num)}
                        className={`w-7 h-7 rounded-lg text-xs font-mono font-bold transition-colors ${
                          currentDay.bm_count === num
                            ? "bg-zinc-100 text-zinc-900"
                            : "bg-zinc-800 text-zinc-400 hover:text-white"
                        }`}
                      >
                        {num}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {/* 30-Day Weight & Net Carbs Trend Charts */}
            <div className="bg-zinc-900/40 p-4 rounded-2xl border border-zinc-800 space-y-2">
              <div className="flex justify-between items-center text-xs text-zinc-400 font-mono">
                <span>30-Day Weight Trajectory (kg)</span>
                <span className="text-emerald-400 font-bold">Latest: {currentDay.weight_kg || 88.9} kg</span>
              </div>
              <div className="h-44 w-full">
                <ResponsiveContainer width="100%" height="100%">
                  <LineChart data={chartData}>
                    <XAxis dataKey="date" stroke="#52525b" fontSize={10} tickLine={false} />
                    <YAxis stroke="#52525b" domain={['dataMin - 1', 'dataMax + 1']} fontSize={10} tickLine={false} orientation="right" />
                    <Tooltip contentStyle={{ backgroundColor: '#18181b', borderColor: '#27272a', borderRadius: '8px', fontSize: '12px' }} />
                    <Line type="monotone" dataKey="weight" stroke="#e4e4e7" strokeWidth={2} dot={{ r: 2, fill: '#e4e4e7' }} />
                  </LineChart>
                </ResponsiveContainer>
              </div>
            </div>

