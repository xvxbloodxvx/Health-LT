                <button
                  key={rt.id}
                  onClick={() => updateCurrentDay("active_routine", rt.id)}
                  className={`p-3 rounded-xl border text-left font-mono transition-all ${
                    (currentDay.active_routine || "day_1") === rt.id
                      ? "bg-zinc-100 text-zinc-950 font-bold border-zinc-100"
                      : "bg-zinc-900/60 text-zinc-400 border-zinc-800 hover:border-zinc-700"
                  }`}
                >
                  <div className="text-[10px] uppercase tracking-widest text-zinc-500">Cycle Routine</div>
                  <div className="text-xs font-semibold mt-0.5">{rt.label}</div>
                </button>
              ))}
            </div>

