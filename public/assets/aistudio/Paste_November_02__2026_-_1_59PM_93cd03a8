                            />
                          </div>
                        </div>

                        <button
                          onClick={() => startRestTimer(bench.rest_sec, `R${round} Rest`)}
                          className="px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded text-[11px]"
                        >
                          Autofill
